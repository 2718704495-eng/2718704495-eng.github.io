---
import { profile } from '../data/portfolio';

const facts = [profile.graduation, profile.location, profile.availability];
---

<section id="about" class="hero section" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow"><span aria-hidden="true"></span> OPEN TO WORK · HANGZHOU</p>
      <p class="role">{profile.title}</p>
      <h1 id="hero-title">{profile.name}</h1>
      <p class="tagline">{profile.tagline}</p>
      <p class="summary">{profile.summary}</p>
      <ul class="facts" aria-label="个人状态">
        {facts.map((fact) => <li>{fact}</li>)}
      </ul>
      <div class="hero-actions">
        <a class="button button-primary" href="#projects">查看项目 <span aria-hidden="true">↓</span></a>
        <a class="button button-secondary" href={profile.resume} download>下载简历</a>
        <a class="button button-ghost" href={profile.github} target="_blank" rel="noreferrer">
          访问 GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <aside class="hero-console" aria-label="个人工程能力摘要">
      <div class="console-bar" aria-hidden="true">
        <span></span><span></span><span></span>
        <small>profile.ts</small>
      </div>
      <div class="console-body">
        <p><span class="syntax-muted">const</span> engineer = {'{'}</p>
        <p class="indent">focus: <span class="syntax-string">'AI 应用与全栈交付'</span>,</p>
        <p class="indent">languages: [<span class="syntax-string">'Java'</span>, <span class="syntax-string">'Python'</span>],</p>
        <p class="indent">delivery: <span class="syntax-string">'需求 → 代码 → 验证'</span>,</p>
        <p class="indent">evidence: <span class="syntax-boolean">true</span>,</p>
        <p>{'}'};</p>
      </div>
      <div class="console-status">
        <span><i aria-hidden="true"></i> 可随时到岗</span>
        <span>BUILD VERIFIED</span>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero {
    display: grid;
    min-height: calc(100vh - 5.5rem);
    padding-block: clamp(4rem, 10vw, 8rem);
    align-items: center;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(20rem, 0.88fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: center;
  }

  .eyebrow,
  .role {
    margin: 0;
    color: var(--color-primary);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1.5rem;
  }

  .eyebrow span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-secondary);
    box-shadow: 0 0 0 0.35rem rgb(94 230 168 / 0.12);
  }

  .role {
    color: var(--color-secondary);
    letter-spacing: 0.06em;
  }

  h1 {
    margin: 0.25rem 0 0;
    font-size: clamp(4.2rem, 10vw, 8.5rem);
    font-weight: 850;
    letter-spacing: -0.075em;
    line-height: 0.94;
  }

  .tagline {
    max-width: 15em;
    margin: 1.75rem 0 0;
    font-size: clamp(1.35rem, 3vw, 2.15rem);
    font-weight: 720;
    letter-spacing: -0.035em;
    line-height: 1.3;
  }

  .summary {
    max-width: 42rem;
    margin: 1.3rem 0 0;
    color: var(--color-muted);
    font-size: 1.03rem;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    padding: 0.32rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 72%, transparent);
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 650;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-console {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-surface) 90%, transparent);
    box-shadow: var(--shadow-card), 0 0 80px rgb(72 215 255 / 0.08);
  }

  .console-bar,
  .console-status {
    display: flex;
    align-items: center;
    border-color: var(--color-border);
    background: color-mix(in srgb, var(--color-surface-raised) 72%, transparent);
  }

  .console-bar {
    gap: 0.4rem;
    min-height: 3.25rem;
    padding-inline: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .console-bar span {
    width: 0.68rem;
    height: 0.68rem;
    border-radius: 50%;
    background: #ff6b6b;
  }

  .console-bar span:nth-child(2) { background: #f7c95c; }
  .console-bar span:nth-child(3) { background: #5ee6a8; }

  .console-bar small {
    margin-left: 0.55rem;
    color: var(--color-muted);
    font: 600 0.78rem ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .console-body {
    min-height: 17rem;
    padding: 2rem;
    font: 500 clamp(0.8rem, 1.6vw, 0.96rem)/1.9 ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .console-body p { margin: 0; }
  .indent { padding-left: 1.4rem; }
  .syntax-muted { color: #bd9cff; }
  .syntax-string { color: var(--color-secondary); }
  .syntax-boolean { color: var(--color-primary); }

  .console-status {
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font: 700 0.7rem ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.06em;
  }

  .console-status span:first-child {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .console-status i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-secondary);
  }

  @media (max-width: 860px) {
    .hero { min-height: auto; }
    .hero-grid { grid-template-columns: 1fr; }
    .hero-console { max-width: 38rem; }
  }

  @media (max-width: 520px) {
    h1 { font-size: clamp(3.7rem, 20vw, 5.8rem); }
    .hero-actions { flex-direction: column; }
    .button { width: 100%; }
    .console-body { padding: 1.25rem; overflow-x: auto; }
  }
</style>
