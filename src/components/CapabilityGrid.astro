---
import { capabilities } from '../data/portfolio';
---

<section class="section capabilities" aria-labelledby="capabilities-title">
  <div class="container">
    <div class="section-heading" data-reveal>
      <div>
        <p class="section-kicker">01 / WHAT I DO</p>
        <p class="side-note">从需求到上线<br />独立推进完整链路</p>
      </div>
      <div>
        <h2 id="capabilities-title">能力不是<br />关键词。</h2>
        <p>它应该落在真实的接口、状态、数据和交付结果里。下面四项，是我解决业务问题时反复使用的能力组合。</p>
      </div>
    </div>

    <div class="capability-list">
      {capabilities.map((capability, index) => (
        <article class="capability-row" data-capability data-reveal>
          <span class="row-index">0{index + 1}</span>
          <div class="row-title">
            <h3>{capability.title}</h3>
            <p>{capability.evidence}</p>
          </div>
          <p class="row-description">{capability.description}</p>
          <ul class="tag-list" aria-label={`${capability.title}技术`}>
            {capability.technologies.map((technology) => <li>{technology}</li>)}
          </ul>
          <svg viewBox="0 0 40 40" aria-hidden="true">
            <path d="M8 20h24M23 11l9 9-9 9" />
          </svg>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .capabilities {
    background: var(--color-paper);
  }

  .section-heading > div:last-child p {
    max-width: 38rem;
    margin: 1.5rem 0 0;
    color: var(--color-muted);
    font-size: 1.08rem;
  }

  .side-note {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.55;
  }

  .capability-list {
    border-top: 1px solid var(--color-dark);
  }

  .capability-row {
    position: relative;
    display: grid;
    grid-template-columns: 3rem minmax(12rem, 0.78fr) minmax(15rem, 1fr) minmax(13rem, 0.8fr) 2.5rem;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    min-width: 0;
    padding-block: 2.2rem;
    border-bottom: 1px solid var(--color-dark);
    align-items: start;
    isolation: isolate;
  }

  .capability-row::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-accent);
    content: '';
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .capability-row:hover::before {
    transform: scaleY(1);
  }

  .row-index {
    font: 600 0.68rem/1 var(--font-mono);
  }

  h3 {
    margin: -0.15rem 0 0;
    font-size: clamp(1.3rem, 2.2vw, 1.85rem);
    letter-spacing: -0.035em;
  }

  .row-title p,
  .row-description {
    margin: 0.7rem 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .row-description {
    margin-top: 0;
    color: var(--color-text);
  }

  .tag-list {
    margin: 0;
  }

  svg {
    width: 2.25rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .capability-row:hover svg {
    transform: translateX(0.4rem);
  }

  .capability-row:hover .row-title p {
    color: var(--color-text);
  }

  @media (max-width: 960px) {
    .capability-row {
      grid-template-columns: 2.5rem minmax(0, 0.9fr) minmax(0, 1.1fr) 2rem;
    }

    .tag-list {
      grid-column: 2 / 4;
    }

    svg {
      grid-column: 4;
      grid-row: 1;
    }
  }

  @media (max-width: 620px) {
    .capability-row {
      grid-template-columns: 2rem minmax(0, 1fr) 2rem;
      gap: 0.9rem;
    }

    .row-title,
    .row-description,
    .tag-list {
      grid-column: 2 / -1;
    }

    .row-description {
      margin-top: 0;
    }

    svg {
      grid-column: 3;
      grid-row: 1;
    }
  }

  @container (max-width: 60rem) {
    .capability-row {
      grid-template-columns: 2rem minmax(0, 1fr) 2rem;
      gap: 0.9rem;
    }

    .row-title,
    .row-description,
    .tag-list {
      grid-column: 2 / -1;
    }

    .row-description {
      margin-top: 0;
    }

    svg {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
