---
import { workflow } from '../data/portfolio';
---

<section id="workflow" class="section workflow" aria-labelledby="workflow-title">
  <div class="container">
    <div class="workflow-intro" data-reveal>
      <p class="section-kicker">04 / HOW I WORK</p>
      <h2 id="workflow-title"><span>AI 加速，</span><br />证据交付。</h2>
      <p>AI 用于澄清、拆解、编码与排障；最终结论仍由人工审查、自动化测试、日志和数据核对确认。</p>
    </div>

    <ol class="workflow-list">
      {workflow.map((step, index) => (
        <li data-workflow-step data-reveal>
          <span class="step-number">0{index + 1}</span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </li>
      ))}
    </ol>

    <div class="workflow-rule" data-reveal>
      <span aria-hidden="true">→</span>
      <p><strong>原则：</strong>AI 提高推进速度，工程证据决定能否交付。</p>
      <span aria-hidden="true">←</span>
    </div>
  </div>
</section>

<style>
  .workflow {
    background: var(--color-accent);
  }

  .workflow-intro {
    display: grid;
    grid-template-columns: minmax(10rem, 0.35fr) minmax(22rem, 0.82fr) minmax(18rem, 0.58fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: end;
  }

  .workflow-intro > * {
    min-width: 0;
  }

  .workflow-intro h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4rem, 9vw, 8.5rem);
    font-weight: 850;
    letter-spacing: -0.085em;
    line-height: 0.82;
    text-transform: uppercase;
  }

  .workflow-intro h2 span {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-text);
  }

  .workflow-intro > p:last-child {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    overflow-wrap: anywhere;
  }

  .workflow-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: clamp(3.5rem, 8vw, 7rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--color-dark);
    border-left: 1px solid var(--color-dark);
    list-style: none;
  }

  .workflow-list li {
    position: relative;
    min-height: 16rem;
    padding: 1.5rem;
    border-right: 1px solid var(--color-dark);
    border-bottom: 1px solid var(--color-dark);
    transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  .workflow-list li:hover {
    background: var(--color-dark);
    color: var(--color-on-dark);
  }

  .step-number {
    font: 700 0.7rem/1 var(--font-mono);
  }

  h3 {
    max-width: 8em;
    margin: 3rem 0 0;
    font-size: clamp(1.25rem, 2.5vw, 1.8rem);
    letter-spacing: -0.035em;
  }

  li p {
    margin: 0.8rem 0 0;
    font-size: 0.9rem;
  }

  .workflow-rule {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
    align-items: center;
  }

  .workflow-rule span:last-child {
    text-align: right;
  }

  .workflow-rule p {
    margin: 0;
    font-size: clamp(1rem, 2vw, 1.25rem);
    text-align: center;
  }

  @media (max-width: 850px) {
    .workflow-intro {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .workflow-intro > p:last-child {
      max-width: 40rem;
    }

    .workflow-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container (max-width: 60rem) {
    .workflow-intro {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .workflow-intro > p:last-child {
      max-width: 40rem;
    }

    .workflow-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container (max-width: 30rem) {
    .workflow-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .workflow-intro h2 {
      font-size: clamp(3.8rem, 20vw, 6rem);
    }

    .workflow-list {
      grid-template-columns: 1fr;
    }

    .workflow-list li {
      min-height: 12rem;
    }

    .workflow-rule {
      grid-template-columns: auto 1fr auto;
      gap: 0.6rem;
    }
  }
</style>
