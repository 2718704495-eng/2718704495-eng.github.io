---
import { experience } from '../data/portfolio';
---

<section id="experience" class="section experience" aria-labelledby="experience-title">
  <div class="container experience-layout">
    <div class="experience-intro" data-reveal>
      <p class="section-kicker">02 / EXPERIENCE</p>
      <h2 id="experience-title">真实业务<br />如何落地。</h2>
      <p>不只写“参与开发”，而是讲清楚我负责什么、解决什么问题，以及最终形成什么结果。</p>
      <div class="experience-stamp" aria-hidden="true">
        <span>7+</span>
        <small>MONTHS OF<br />DELIVERY</small>
      </div>
    </div>

    <div class="timeline">
      {experience.map((item, index) => (
        <article class="experience-entry" data-experience data-reveal>
          <div class="entry-head">
            <p class="period">{item.period}</p>
            <span>ROLE / 0{index + 1}</span>
          </div>
          <h3>{item.company}</h3>
          <p class="role">{item.role}</p>
          <p class="summary">{item.summary}</p>
          <ol>
            {item.bullets.map((bullet, bulletIndex) => (
              <li><span>0{bulletIndex + 1}</span><p>{bullet}</p></li>
            ))}
          </ol>
          <div class="outcome">
            <span>DELIVERED</span>
            <p>{item.outcome}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .experience {
    background: var(--color-dark);
    color: var(--color-on-dark);
  }

  .experience-layout {
    display: grid;
    grid-template-columns: minmax(16rem, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(3rem, 9vw, 8rem);
    align-items: start;
  }

  .experience-intro {
    position: sticky;
    top: 4rem;
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 7vw, 6.5rem);
    font-weight: 850;
    letter-spacing: -0.075em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .experience-intro > p:not(.section-kicker) {
    max-width: 28rem;
    margin: 1.75rem 0 0;
    color: #b8b6ad;
  }

  .experience-stamp {
    display: flex;
    width: 10.5rem;
    aspect-ratio: 1;
    margin-top: 3rem;
    border: 1px solid #77756e;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    transform: rotate(-8deg);
  }

  .experience-stamp span {
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 3.4rem;
    font-weight: 850;
    line-height: 1;
  }

  .experience-stamp small {
    font: 600 0.58rem/1.4 var(--font-mono);
    letter-spacing: 0.04em;
  }

  .timeline {
    min-width: 0;
    border-top: 1px solid #5a5953;
  }

  .experience-entry {
    min-width: 0;
    padding-block: clamp(2.5rem, 6vw, 5rem);
    border-bottom: 1px solid #5a5953;
  }

  .entry-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .period,
  .entry-head > span,
  .role {
    margin: 0;
    font: 650 0.7rem/1.4 var(--font-mono);
    letter-spacing: 0.06em;
  }

  .period,
  .role {
    color: var(--color-accent);
  }

  .entry-head > span {
    color: #949188;
  }

  h3 {
    max-width: 18em;
    margin: 1.2rem 0 0.35rem;
    font-size: clamp(1.9rem, 4vw, 3.25rem);
    letter-spacing: -0.05em;
    line-height: 1.08;
    overflow-wrap: anywhere;
  }

  .summary {
    max-width: 42rem;
    margin: 1.5rem 0 0;
    color: #c9c6bc;
    font-size: 1.05rem;
    overflow-wrap: anywhere;
  }

  ol {
    display: grid;
    gap: 0;
    margin: 2rem 0 0;
    padding: 0;
    border-top: 1px solid #41403c;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid #41403c;
  }

  li span {
    padding-top: 0.18rem;
    color: #8f8c84;
    font: 600 0.62rem/1 var(--font-mono);
  }

  li p {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .outcome {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1.25rem;
    margin-top: 1.5rem;
    padding: 1.2rem;
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .outcome span {
    padding-top: 0.2rem;
    font: 800 0.65rem/1 var(--font-mono);
    letter-spacing: 0.08em;
  }

  .outcome p {
    margin: 0;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  @media (max-width: 820px) {
    .experience-layout {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .experience-intro {
      position: static;
    }
  }

  @container (max-width: 60rem) {
    .experience-layout {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .experience-intro {
      position: static;
    }
  }

  @media (max-width: 520px) {
    .experience-stamp {
      width: 8.5rem;
    }

    .outcome {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }
  }
</style>
