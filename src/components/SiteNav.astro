---
import { profile } from '../data/portfolio';

const navItems = [
  { href: '#about', label: '关于' },
  { href: '#experience', label: '经历' },
  { href: '#projects', label: '项目' },
  { href: '#workflow', label: 'AI 工作流' },
  { href: '#contact', label: '联系' },
];
---

<header class="site-header">
  <nav class="site-nav container" aria-label="主导航">
    <a class="brand" href="#about" aria-label={`${profile.name}，返回个人介绍`}>
      <span aria-hidden="true">WX</span>
      <strong>{profile.name}</strong>
    </a>
    <div class="nav-links">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: 0.75rem;
    pointer-events: none;
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
    padding: 0.55rem 0.7rem 0.55rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--color-border) 86%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    box-shadow: var(--shadow-nav);
    backdrop-filter: blur(18px);
    pointer-events: auto;
  }

  .brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
  }

  .brand span {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    color: #04121c;
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.03em;
    place-items: center;
  }

  .brand strong {
    font-size: 0.95rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .nav-links::-webkit-scrollbar {
    display: none;
  }

  .nav-links a {
    min-height: 2.65rem;
    padding: 0.55rem 0.8rem;
    border-radius: 999px;
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition-fast), background var(--transition-fast);
  }

  .nav-links a:hover {
    background: var(--color-surface-raised);
    color: var(--color-text);
  }

  @media (max-width: 720px) {
    .site-header {
      padding-block: 0.5rem;
    }

    .site-nav {
      gap: 0.4rem;
      padding-inline: 0.55rem;
      border-radius: var(--radius-md);
      flex-wrap: wrap;
    }

    .brand {
      display: none;
    }

    .nav-links {
      width: 100%;
      overflow: visible;
      flex: 1 1 100%;
      flex-wrap: wrap;
      justify-content: center;
    }

    .nav-links a {
      padding-inline: 0.65rem;
      font-size: 0.82rem;
    }
  }
</style>
