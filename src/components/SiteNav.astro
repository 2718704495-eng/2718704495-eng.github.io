---
import { profile } from '../data/portfolio';

const navItems = [
  { href: '#about', label: '首页' },
  { href: '#experience', label: '经历' },
  { href: '#projects', label: '项目' },
  { href: '#workflow', label: '方法' },
  { href: '#contact', label: '联系' },
];
---

<header class="site-header">
  <nav class="site-nav container" aria-label="主导航">
    <a class="brand" href="#about" aria-label={`${profile.name}，返回个人介绍`}>
      <span aria-hidden="true">WX</span>
      <strong>{profile.name}</strong>
    </a>
    <div class="nav-links">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
    <a class="nav-resume" href={profile.resume} download>
      简历 PDF <span aria-hidden="true">↘</span>
    </a>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 50;
    width: 100%;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 90%, transparent);
    backdrop-filter: blur(16px);
    container-type: inline-size;
  }

  .site-nav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 1.25rem;
    align-items: center;
  }

  .brand,
  .nav-resume {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.82rem;
    text-decoration: none;
  }

  .brand {
    justify-self: start;
  }

  .brand span {
    display: grid;
    width: 2.45rem;
    height: 2.45rem;
    background: var(--color-dark);
    color: var(--color-accent);
    font: 800 0.72rem/1 var(--font-mono);
    place-items: center;
  }

  .brand strong {
    letter-spacing: 0.02em;
  }

  .nav-links {
    display: flex;
    padding: 0.25rem;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-paper) 88%, transparent);
    backdrop-filter: blur(14px);
  }

  .nav-links a {
    min-height: 2.5rem;
    padding: 0.55rem 0.85rem;
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  .nav-links a:hover,
  .nav-links a[aria-current='location'] {
    background: var(--color-dark);
    color: var(--color-on-dark);
  }

  .nav-resume {
    min-height: 2.75rem;
    justify-self: end;
    font-weight: 800;
  }

  @media (max-width: 1100px) {
    .site-header {
      position: sticky;
      padding-block: 0;
      border-bottom: 1px solid var(--color-border);
      background: color-mix(in srgb, var(--color-bg) 92%, transparent);
      backdrop-filter: blur(16px);
    }

    .site-nav {
      display: flex;
      min-height: 4rem;
      gap: 0.75rem;
      justify-content: space-between;
    }

    .brand,
    .nav-resume {
      display: none;
    }

    .nav-links {
      width: 100%;
      min-width: 0;
      padding: 0;
      border: 0;
      background: transparent;
      overflow-x: auto;
      flex-wrap: wrap;
      justify-content: center;
      scrollbar-width: none;
    }

    .nav-links::-webkit-scrollbar {
      display: none;
    }

    .nav-links a {
      min-height: 2.75rem;
      padding-inline: 0.65rem;
    }
  }

  @container (max-width: 60rem) {
    .site-nav {
      display: flex;
      min-height: 4rem;
      gap: 0.75rem;
      justify-content: space-between;
    }

    .brand,
    .nav-resume {
      display: none;
    }

    .nav-links {
      width: 100%;
      min-width: 0;
      padding: 0;
      border: 0;
      background: transparent;
      overflow-x: auto;
      flex-wrap: wrap;
      justify-content: center;
      scrollbar-width: none;
    }

    .nav-links::-webkit-scrollbar {
      display: none;
    }

    .nav-links a {
      min-height: 2.75rem;
      padding-inline: 0.65rem;
    }
  }
</style>
