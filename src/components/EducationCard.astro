---
import { education, profile } from '../data/portfolio';
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container contact-grid">
    <article class="education-card">
      <p class="section-kicker">05 / EDUCATION</p>
      <h2>教育与荣誉</h2>
      <p class="period">{education.period}</p>
      <h3>{education.school}</h3>
      <p>{education.degree} · {education.ranking}</p>
      <ul class="tag-list" aria-label="核心课程">
        {education.courses.map((course) => <li>{course}</li>)}
      </ul>
      <div class="award">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 4h8v5a4 4 0 0 1-8 0V4Zm0 2H4v2a4 4 0 0 0 4 4m8-6h4v2a4 4 0 0 1-4 4m-4 1v4m-3 3h6" />
        </svg>
        <div><span>竞赛荣誉</span><strong>{education.award}</strong></div>
      </div>
    </article>

    <article class="contact-card">
      <p class="section-kicker">06 / CONTACT</p>
      <h2 id="contact-title">一起把想法变成<br />可交付的产品。</h2>
      <p>关注 AI 应用、Java/Python 全栈与真实业务闭环，欢迎通过邮箱或 GitHub 联系。</p>
      <div class="contact-actions">
        <a class="button button-primary" href={`mailto:${profile.email}`}>发送邮件</a>
        <a class="button button-secondary" href={profile.github} target="_blank" rel="noreferrer">访问 GitHub</a>
        <a class="button button-ghost" href={profile.resume} download>下载简历</a>
      </div>
      <dl>
        <div><dt>EMAIL</dt><dd>{profile.email}</dd></div>
        <div><dt>BASE</dt><dd>{profile.location}</dd></div>
        <div><dt>STATUS</dt><dd>{profile.availability}</dd></div>
      </dl>
    </article>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: 1.2rem;
  }

  article {
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  h2 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.4rem);
    letter-spacing: -0.05em;
    line-height: 1.08;
  }

  .period {
    margin: 2.2rem 0 0;
    color: var(--color-primary);
    font: 800 0.78rem ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  h3 { margin: 0.5rem 0 0; font-size: 1.35rem; }

  .education-card > p:not(.period, .section-kicker),
  .contact-card > p {
    color: var(--color-muted);
  }

  .award {
    display: flex;
    gap: 0.85rem;
    margin-top: 1.8rem;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-secondary) 35%, var(--color-border));
    border-radius: var(--radius-sm);
    background: rgb(94 230 168 / 0.055);
  }

  .award svg {
    flex: 0 0 auto;
    width: 1.6rem;
    color: var(--color-secondary);
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .award span,
  .award strong { display: block; }
  .award span { color: var(--color-muted); font-size: 0.75rem; }
  .award strong { margin-top: 0.15rem; }

  .contact-card {
    background:
      radial-gradient(circle at 100% 0%, rgb(72 215 255 / 0.16), transparent 20rem),
      var(--color-surface);
  }

  .contact-card > p { max-width: 38rem; }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.8rem;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 2.4rem 0 0;
  }

  dl div {
    min-width: 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-border);
  }

  dt {
    color: var(--color-primary);
    font: 800 0.66rem ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.08em;
  }

  dd {
    margin: 0.3rem 0 0;
    overflow-wrap: anywhere;
    font-size: 0.82rem;
    font-weight: 650;
  }

  @media (max-width: 820px) {
    .contact-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 520px) {
    .contact-actions { flex-direction: column; }
    .button { width: 100%; }
    dl { grid-template-columns: 1fr; }
  }
</style>
