---
import { education, profile } from '../data/portfolio';
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="education" data-reveal>
      <div>
        <p class="section-kicker">05 / EDUCATION</p>
        <p class="period">{education.period}</p>
      </div>
      <div>
        <h2>教育与荣誉</h2>
        <h3>{education.school}</h3>
        <p>{education.degree} · {education.ranking}</p>
      </div>
      <div class="education-detail">
        <ul class="tag-list" aria-label="核心课程">
          {education.courses.map((course) => <li>{course}</li>)}
        </ul>
        <div class="award">
          <span>AWARD</span>
          <strong>{education.award}</strong>
        </div>
      </div>
    </div>

    <div class="contact-panel" data-reveal>
      <div class="contact-copy">
        <p class="section-kicker">06 / CONTACT</p>
        <h2 id="contact-title">一起做点<br /><em>真正能用的。</em></h2>
        <p>关注 AI 应用、Java/Python 全栈与真实业务闭环，欢迎通过邮箱或 GitHub 联系。</p>
      </div>
      <div class="contact-side">
        <div class="contact-actions">
          <a class="contact-link" href={`mailto:${profile.email}`}>
            <span>发送邮件</span><strong aria-hidden="true">↗</strong>
          </a>
          <a class="contact-link" href={profile.github} target="_blank" rel="noreferrer">
            <span>访问 GitHub</span><strong aria-hidden="true">↗</strong>
          </a>
          <a class="contact-link" href={profile.resume} download>
            <span>下载简历</span><strong aria-hidden="true">↓</strong>
          </a>
        </div>
        <dl>
          <div><dt>EMAIL</dt><dd>{profile.email}</dd></div>
          <div><dt>BASE</dt><dd>{profile.location}</dd></div>
          <div><dt>STATUS</dt><dd>{profile.availability}</dd></div>
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-bottom: 0;
    background: var(--color-paper);
  }

  .education {
    display: grid;
    grid-template-columns: minmax(9rem, 0.35fr) minmax(18rem, 0.9fr) minmax(17rem, 0.7fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    padding-bottom: clamp(5rem, 10vw, 9rem);
    align-items: start;
  }

  .period {
    margin: 2rem 0 0;
    font: 700 0.75rem/1.4 var(--font-mono);
  }

  .education h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 5.5rem);
    letter-spacing: -0.07em;
    line-height: 0.9;
  }

  .education h3 {
    margin: 2rem 0 0;
    font-size: clamp(1.35rem, 2.5vw, 2rem);
    letter-spacing: -0.035em;
  }

  .education h3 + p {
    margin: 0.4rem 0 0;
    color: var(--color-muted);
  }

  .education-detail {
    padding-top: 0.4rem;
  }

  .education-detail .tag-list {
    margin-top: 0;
  }

  .award {
    display: grid;
    gap: 0.65rem;
    margin-top: 2rem;
    padding: 1.25rem;
    border: 1px solid var(--color-dark);
    background: var(--color-accent);
    box-shadow: 6px 6px 0 var(--color-dark);
    transform: rotate(1.5deg);
  }

  .award span {
    font: 700 0.65rem/1 var(--font-mono);
    letter-spacing: 0.08em;
  }

  .award strong {
    line-height: 1.4;
  }

  .contact-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
    gap: clamp(3rem, 9vw, 8rem);
    padding: clamp(2rem, 6vw, 5rem);
    background: var(--color-dark);
    color: var(--color-on-dark);
  }

  .contact-copy h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.6rem, 8vw, 7.7rem);
    font-weight: 850;
    letter-spacing: -0.085em;
    line-height: 0.84;
  }

  .contact-copy h2 em {
    color: var(--color-accent);
    font-style: normal;
  }

  .contact-copy > p:last-child {
    max-width: 36rem;
    margin: 2rem 0 0;
    color: #bab7ae;
  }

  .contact-side {
    align-self: end;
  }

  .contact-actions {
    border-top: 1px solid #77756e;
  }

  .contact-link {
    display: flex;
    min-height: 4.25rem;
    padding-block: 1rem;
    border-bottom: 1px solid #77756e;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 750;
    text-decoration: none;
    transition: padding var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  .contact-link:hover {
    padding-inline: 0.65rem;
    color: var(--color-accent);
  }

  .contact-link strong {
    font-size: 1.4rem;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 2.4rem 0 0;
  }

  dl div {
    min-width: 0;
  }

  dl div:first-child {
    grid-column: 1 / -1;
  }

  dt {
    color: #8e8b84;
    font: 700 0.6rem/1 var(--font-mono);
    letter-spacing: 0.08em;
  }

  dd {
    margin: 0.4rem 0 0;
    overflow-wrap: anywhere;
    font-size: 0.78rem;
    font-weight: 650;
  }

  @media (max-width: 850px) {
    .education,
    .contact-panel {
      grid-template-columns: 1fr;
    }

    .education-detail {
      max-width: 32rem;
    }
  }

  @container (max-width: 60rem) {
    .education,
    .contact-panel {
      grid-template-columns: 1fr;
    }

    .education-detail {
      max-width: 32rem;
    }
  }

  @media (max-width: 520px) {
    .contact-panel {
      margin-inline: -0.625rem;
    }

    dl {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }
  }
</style>
