---
import { projects } from '../data/portfolio';

const projectMarks = ['MED·AI', 'MAP·3D', 'WE·AI', 'META'];
const projectTones = ['dark', 'lime', 'paper', 'gray'];
---

<section id="projects" class="section projects" aria-labelledby="projects-title">
  <div class="container">
    <div class="section-heading project-heading" data-reveal>
      <div>
        <p class="section-kicker">03 / SELECTED WORK</p>
        <p class="project-count">04 CASES<br />2025—2026</p>
      </div>
      <div>
        <h2 id="projects-title">代表项目</h2>
        <p>每个项目都从业务问题出发，展开本人职责、技术方案和形成结果。重点不是“用了什么”，而是“为什么这样做”。</p>
      </div>
    </div>

    <div class="project-list">
      {projects.map((project, index) => (
        <article
          class="project-case"
          data-project
          data-reveal
          data-featured={index === 0 ? 'true' : 'false'}
          data-tone={projectTones[index]}
        >
          <div class="project-visual" aria-hidden="true">
            <span class="visual-number">0{index + 1}</span>
            <span class="visual-mark">{projectMarks[index]}</span>
            <span class="visual-status">{project.status}</span>
            <div class="visual-orbit"></div>
            <svg viewBox="0 0 180 180">
              <path d="M22 145C68 153 134 113 145 37M114 54l31-17 6 35" />
            </svg>
          </div>

          <div class="project-content">
            <div class="project-head">
              <span>PROJECT / 0{index + 1}</span>
              <span>{project.status}</span>
            </div>
            <h3>{project.name}</h3>
            <p class="project-summary">{project.summary}</p>

            <dl class="project-closure">
              <div>
                <dt>业务场景</dt>
                <dd>{project.problem}</dd>
              </div>
              <div>
                <dt>我负责</dt>
                <dd>{project.work}</dd>
              </div>
              <div>
                <dt>技术方案</dt>
                <dd>{project.solution}</dd>
              </div>
              <div class="result">
                <dt>形成结果</dt>
                <dd>{project.outcome}</dd>
              </div>
            </dl>

            <div class="project-footer">
              <ul class="tag-list" aria-label={`${project.name}技术栈`}>
                {project.technologies.map((technology) => <li>{technology}</li>)}
              </ul>
              {project.href && (
                <a data-project-link href={project.href} target="_blank" rel="noreferrer">
                  查看项目 <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .projects {
    background: var(--color-bg);
  }

  .project-heading > div:last-child p {
    max-width: 42rem;
    margin: 1.5rem 0 0;
    color: var(--color-muted);
    font-size: 1.08rem;
  }

  .project-count {
    margin: 0;
    color: var(--color-muted);
    font: 650 0.78rem/1.55 var(--font-mono);
  }

  .project-list {
    display: grid;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .project-case {
    display: grid;
    grid-template-columns: minmax(18rem, 0.82fr) minmax(0, 1.18fr);
    min-width: 0;
    border-top: 1px solid var(--color-dark);
  }

  .project-case:nth-child(even) {
    grid-template-columns: minmax(0, 1.18fr) minmax(18rem, 0.82fr);
  }

  .project-case:nth-child(even) .project-visual {
    grid-column: 2;
  }

  .project-case:nth-child(even) .project-content {
    grid-column: 1;
    grid-row: 1;
    padding-left: 0;
    padding-right: clamp(1.5rem, 6vw, 5rem);
  }

  .project-visual {
    position: relative;
    min-height: 34rem;
    overflow: hidden;
    background: var(--color-dark);
    color: var(--color-on-dark);
  }

  .project-case[data-tone='lime'] .project-visual {
    background: var(--color-accent);
    color: var(--color-text);
  }

  .project-case[data-tone='paper'] .project-visual {
    border: 1px solid var(--color-dark);
    border-top: 0;
    background: var(--color-paper);
    color: var(--color-text);
  }

  .project-case[data-tone='gray'] .project-visual {
    background: #d3d0c6;
    color: var(--color-text);
  }

  .visual-number {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    font: 700 0.75rem/1 var(--font-mono);
  }

  .visual-mark {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    font-family: var(--font-display);
    font-size: clamp(4.2rem, 8vw, 8rem);
    font-weight: 850;
    letter-spacing: -0.085em;
    line-height: 0.8;
    white-space: nowrap;
    transform: translate(-50%, -50%) rotate(-7deg);
  }

  .visual-status {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 2;
    padding: 0.45rem 0.65rem;
    border: 1px solid currentColor;
    font: 700 0.65rem/1 var(--font-mono);
  }

  .visual-orbit {
    position: absolute;
    top: 17%;
    left: 15%;
    width: 72%;
    aspect-ratio: 1;
    border: 1px solid currentColor;
    border-radius: 50%;
    opacity: 0.55;
    transform: rotate(19deg);
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .visual-orbit::before,
  .visual-orbit::after {
    position: absolute;
    border: 1px solid currentColor;
    border-radius: 50%;
    content: '';
  }

  .visual-orbit::before {
    inset: 13% -11%;
  }

  .visual-orbit::after {
    inset: -11% 13%;
  }

  .project-case:hover .visual-orbit {
    transform: rotate(34deg) scale(1.03);
  }

  .project-visual svg {
    position: absolute;
    right: -1.5rem;
    bottom: -1.25rem;
    width: 11rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.6;
    opacity: 0.72;
  }

  .project-content {
    min-width: 0;
    padding: clamp(2rem, 5vw, 4rem) 0 clamp(1rem, 3vw, 2rem) clamp(1.5rem, 6vw, 5rem);
  }

  .project-head,
  .project-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .project-head {
    color: var(--color-muted);
    font: 650 0.68rem/1 var(--font-mono);
    letter-spacing: 0.05em;
  }

  h3 {
    max-width: 100%;
    margin: 1.2rem 0 0;
    font-size: clamp(2.1rem, 4.3vw, 3.8rem);
    letter-spacing: -0.065em;
    line-height: 0.98;
    overflow-wrap: anywhere;
  }

  .project-summary {
    max-width: 42rem;
    margin: 1.15rem 0 0;
    color: var(--color-muted);
    font-size: 1.02rem;
  }

  .project-closure {
    display: grid;
    margin: 2rem 0 0;
  }

  .project-closure > div {
    display: grid;
    grid-template-columns: 5.2rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.85rem;
    border-top: 1px solid var(--color-border);
  }

  dt {
    font-size: 0.76rem;
    font-weight: 850;
  }

  dd {
    min-width: 0;
    margin: 0;
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }

  .result {
    margin-top: 0.2rem;
    padding-inline: 0.75rem;
    border-top-color: var(--color-dark) !important;
    background: var(--color-accent);
  }

  .result dd {
    font-weight: 700;
  }

  .project-footer {
    align-items: flex-end;
    margin-top: 1.25rem;
  }

  .project-footer .tag-list {
    margin: 0;
  }

  .project-footer a {
    flex: 0 0 auto;
    min-height: 2.75rem;
    font-size: 0.85rem;
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .project-case,
    .project-case:nth-child(even) {
      grid-template-columns: 1fr;
    }

    .project-case:nth-child(even) .project-visual,
    .project-case:nth-child(even) .project-content {
      grid-column: auto;
      grid-row: auto;
    }

    .project-content,
    .project-case:nth-child(even) .project-content {
      padding: 2rem 0 0;
    }

    .project-visual {
      min-height: 27rem;
    }
  }

  @container (max-width: 60rem) {
    .project-case,
    .project-case:nth-child(even) {
      grid-template-columns: 1fr;
    }

    .project-case:nth-child(even) .project-visual,
    .project-case:nth-child(even) .project-content {
      grid-column: auto;
      grid-row: auto;
    }

    .project-content,
    .project-case:nth-child(even) .project-content {
      padding: 2rem 0 0;
    }

    .project-visual {
      min-height: 27rem;
    }
  }

  @media (max-width: 520px) {
    .project-visual {
      min-height: 20rem;
    }

    .visual-mark {
      font-size: clamp(3.5rem, 18vw, 5rem);
    }

    .project-closure > div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .project-footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
