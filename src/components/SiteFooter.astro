---
import { profile } from '../data/portfolio';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>© {new Date().getFullYear()} {profile.name} · 用工程证据完成每一次交付。</p>
    <a href="#about">返回顶部 <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 7rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer a {
    flex: 0 0 auto;
    font-weight: 700;
  }

  @media (max-width: 560px) {
    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
    }
  }
</style>
